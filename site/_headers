# Cloudflare Pages headers. Cloudflare already sends nosniff and
# strict-origin-when-cross-origin. No Permissions-Policy and no CSP on purpose:
# the page reads permission states and browser capabilities, and those headers
# would change the very values it shows the visitor.
/*
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/404.html
  X-Robots-Tag: noindex

# The site lives at https://fprint.morgunov.tech. The technical Pages hosts
# (fingerprint-66l.pages.dev and the per-deployment preview hosts) stay out of search results.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
